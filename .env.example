# === Environment ===
NODE_ENV=development

# === Database ===
DATABASE_URL=postgres://localhost:5432/sintezaur_dev
DATABASE_POOL_SIZE=4
DATABASE_POOL_MAX=20

# === HTTP / CORS ===
API_PORT=3000
WORKER_PORT=3001
SITE_PORT=4200
DASHBOARD_PORT=4201
CORS_ORIGIN=http://localhost:4200,http://localhost:4201

# Public URL of the site (used in emails, OG tags, sitemap URLs)
# Production: https://sintezaur.ro
SITE_BASE_URL=http://localhost:4200
DASHBOARD_BASE_URL=http://localhost:4201

# === Auth ===
# Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=replace-with-32-random-bytes
JWT_REFRESH_SECRET=replace-with-32-random-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_COST=12

# Cookie config (httpOnly Secure SameSite for JWT in production)
# Production: COOKIE_DOMAIN=.sintezaur.ro, COOKIE_SECURE=true
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# === Google OAuth (Sign in with Google) ===
# Optional. When both ID + secret are blank, the "Continue with Google"
# button stays hidden on /login and /signup, and the /auth/google
# routes return 500 (passport "Unknown strategy") if hit directly.
# Wired in post-MVP; the passport-google-oauth20 dependency is
# installed in M0 to avoid version drift when we enable it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to API_BASE_URL + /api/auth/google/callback when unset.
# Must EXACTLY match the URI registered in Google Cloud Console.
GOOGLE_CALLBACK_URL=

# === Superadmin bootstrap (used by tools/scripts/create-superadmin.ts) ===
# Creates the user if missing and grants both `admin` and `superadmin`.
# Idempotent: re-running on an existing row just re-asserts the grants.
# Legacy FIRST_ADMIN_* names are still accepted as a fallback.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_FULL_NAME=
# Optional. Derived from email local-part when blank.
SUPERADMIN_USERNAME=

# === Email (transactional via Brevo SMTP) ===
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Sintezaur
SMTP_FROM_EMAIL=noreply@sintezaur.ro

# Operator inbox for the public /contact form (M6-A). When unset, the
# admin dashboard still receives submissions in the queue but no email
# ping is sent.
CONTACT_OPERATOR_EMAIL=

# === Storage ===
# Driver swap between local-disk and Cloudflare R2 (S3-compatible).
#   STORAGE_DRIVER=local — files on disk under UPLOADS_DIR, served via
#                          /uploads/<key>. Dev default; no R2 creds needed.
#   STORAGE_DRIVER=s3    — files on Cloudflare R2 at files.sintezaur.ro.
#                          Requires R2_* vars below.
STORAGE_DRIVER=local

# Public base URL prepended to every stored object key when building
# user-facing image URLs. Dev = local static server; prod = R2 custom
# domain. NO trailing slash.
STORAGE_PUBLIC_BASE_URL=http://localhost:3000/uploads

# Local driver — disk root for uploads. On Coolify, point at a mounted
# volume so a redeploy doesn't wipe files. Ignored when STORAGE_DRIVER=s3.
UPLOADS_DIR=./storage/uploads

# Cloudflare R2 credentials — only needed on prod (STORAGE_DRIVER=s3).
# Get them from Cloudflare dashboard → R2 → Manage API Tokens.
R2_ENDPOINT=
R2_BUCKET=sintezaur-uploads
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# === Backups ===
# Daily pg_dump cron runs in the worker at 02:30 UTC. Empty BACKUP_DIR
# falls back to ./storage/backups. Coolify-deployed worker should
# point this at a mounted volume; offsite sync (Hetzner Storage Box
# via rclone/rsync) is configured separately — see docs/devops/backups.md.
BACKUP_DIR=./storage/backups
BACKUP_RETAIN_DAYS=14

# === Error tracking ===
# Sentry SDK init is no-op when SENTRY_DSN is empty (dev default).
# Populate on prod from sentry.io project settings.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
# Optional release tag — usually the git SHA, set at build time.
SENTRY_RELEASE=

# === Logging ===
# LOG_FORMAT=pretty requires `pino-pretty` installed (not in the base
# tech stack). Keep `json` unless you've explicitly added pino-pretty.
LOG_LEVEL=info
LOG_FORMAT=json

# === Analytics ===
# Umami Cloud — same pattern as Mudee. Both must be set for the tracker
# to inject; leave blank in dev so localhost traffic stays out of stats.
UMAMI_WEBSITE_ID=
UMAMI_SCRIPT_URL=

# === Bazar (M3) ===
# Listing-related limits. Saved-search cap enforced server-side.
SAVED_SEARCH_MAX_PER_USER=50

# === Notifications (M3 §7.5) ===
# Dedup window — same dedup_key within this many minutes is dropped.
NOTIFICATION_DEDUP_WINDOW_MINUTES=60

# === Forum (M5) ===
# Edit window for forum posts (spec §13 — confirm value before M5 starts)
FORUM_EDIT_WINDOW_MINUTES=30
